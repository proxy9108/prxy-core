# Copy to .env (or /etc/prxy-core/env for the systemd unit). Every integration is optional.
PORT=8443
DATA_DIR=./data
TLS_DIR=./tls
# Postgres (read-only viewer role)
PG_HOST=10.20.40.111
PG_PORT=5432
PG_USER=viewer
PG_PASSWORD=
# Monitoring
PROM_URL=http://10.20.40.116:9090
ALERTMANAGER_URL=http://10.20.40.117:9093
LOKI_URL=http://10.20.40.133:3100
OLLAMA_URL=http://10.20.40.131:11434
RECON_MODEL=phi4
# Proxmox (scoped API token, TLS pinned)
PVE_HOST=10.20.40.10
PVE_PORT=8006
PVE_SERVERNAME=pve-node
PVE_TOKEN_ID=
PVE_TOKEN_SECRET=
PVE_FINGERPRINT=
PVE_CA_FILE=
# OPNsense (read-only API user, TLS pinned)
OPNSENSE_HOST=10.20.40.1
OPNSENSE_SERVERNAME=
OPNSENSE_KEY_FILE=/etc/prxy-core/opnsense.key
OPNSENSE_CERT_FILE=
OPNSENSE_FINGERPRINT=
# UniFi (view-only local account, TLS pinned)
UNIFI_HOST=10.20.40.105
UNIFI_SERVERNAME=
UNIFI_SITE=default
UNIFI_CRED_FILE=/etc/prxy-core/unifi.cred
UNIFI_CERT_FILE=
UNIFI_FINGERPRINT=
# Docker bridge (signed requests)
BRIDGE_HOST=10.20.40.110
BRIDGE_PORT=8098
BRIDGE_SECRET=
BRIDGE_FINGERPRINT=
BRIDGE_CERT_FILE=
# Your own domains for the Exposure check
EXPOSURE_DOMAINS=example.com
